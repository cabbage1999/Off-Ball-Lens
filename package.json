{
  "name": "off-ball-lens",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Author-model dangerous accessible space, tactical replay and evidence-grounded explanations",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "export:data": "node scripts/export-data.mjs",
    "export:analysis": "node scripts/run-python.mjs -m analytics.compute_das",
    "test:analytics": "node scripts/run-python.mjs -m pytest analytics/tests -q",
    "benchmark": "node scripts/run-python.mjs -m analytics.validate",
    "validate": "node scripts/validate.mjs",
    "smoke:foundry": "node scripts/smoke-foundry.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
