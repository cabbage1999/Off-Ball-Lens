# Copy to .env on your own computer. Never commit the real .env file.
# Select an API style supported by the deployment, with native function tools and
# its required output mode: Responses strict JSON schema or Chat JSON mode.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=

# API style defaults to responses (strict JSON schema output).
# For a deployed Azure-sold model supporting native Chat Completions tools and JSON
# mode, such as DeepSeek-V3.2, use chat-completions. The plan is validated locally;
# JSON mode is not strict schema output. This adapter accepts Azure resource URLs
# only, e.g. https://YOUR-RESOURCE.services.ai.azure.com (not a project endpoint).
# FOUNDRY_API_STYLE=chat-completions

# Optional alternative: Foundry project endpoint with a Microsoft Entra bearer token.
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# AZURE_FOUNDRY_AUTH_TOKEN=

HOST=127.0.0.1
PORT=4173
